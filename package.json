{
  "name": "sicove",
  "version": "0.0.1",
  "private": true,
  "description": "CRIS SICOVE - Plataforma tecnológica chilena",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@sicove/web",
    "dev:mobile": "npm run start --workspace=@sicove/mobile",
    "build:web": "npm run build --workspace=@sicove/web",
    "build:shared": "npm run build --workspace=@sicove/shared",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}