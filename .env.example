# =========================================
# SICOVE - Variables de Entorno
# =========================================
# Copiar este archivo a .env.local y completar los valores

# -----------------------------------------
# General
# -----------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://sicovel.vercel.app
ADMIN_ALLOWED_EMAILS=contacto@sicovel.cl

# -----------------------------------------
# Supabase
# -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------
# Database (Django)
# -----------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/sicove
DJANGO_SECRET_KEY=

# -----------------------------------------
# AWS (Producción)
# -----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# -----------------------------------------
# Pagos (Chile)
# -----------------------------------------
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
FLOW_API_KEY=
FLOW_SECRET_KEY=

# -----------------------------------------
# Sentry
# -----------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------
# Otros
# -----------------------------------------
API_URL=http://localhost:3001
DJANGO_API_URL=http://localhost:8000
